# Copiar para .env e substituir todos os valores "change-me".
# Nunca commitar o .env.

# --- PostgreSQL ---
POSTGRES_DB=ticketing
POSTGRES_SUPERUSER=postgres
POSTGRES_SUPERUSER_PASSWORD=change-me
POSTGRES_OWNER_USER=ticketing_owner
POSTGRES_OWNER_PASSWORD=change-me
POSTGRES_APP_USER=ticketing_app
POSTGRES_APP_PASSWORD=change-me
POSTGRES_READONLY_USER=ticketing_readonly
POSTGRES_READONLY_PASSWORD=change-me
# none por omissão; usar all só para a prova de cache
PG_LOG_STATEMENT=none

# --- MongoDB ---
MONGO_ROOT_USER=root
MONGO_ROOT_PASSWORD=change-me
MONGO_DB=ticketing
MONGO_APP_USER=ticketing_app
MONGO_APP_PASSWORD=change-me

# --- Redis ---
REDIS_PASSWORD=change-me

# --- URLs para correr a app no host (uv run), com as portas publicadas em 127.0.0.1 ---
DATABASE_URL=postgresql+psycopg://ticketing_app:change-me@127.0.0.1:5432/ticketing
MIGRATION_DATABASE_URL=postgresql+psycopg://ticketing_owner:change-me@127.0.0.1:5432/ticketing
READONLY_DATABASE_URL=postgresql+psycopg://ticketing_readonly:change-me@127.0.0.1:5432/ticketing
MONGO_URL=mongodb://ticketing_app:change-me@127.0.0.1:27017/ticketing?authSource=ticketing
MONGO_ROOT_URL=mongodb://root:change-me@127.0.0.1:27017/?authSource=admin
REDIS_URL=redis://:change-me@127.0.0.1:6379/0